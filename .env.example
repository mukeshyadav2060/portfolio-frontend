# Base URL of the backend app (server-side only)
BACKEND_URL=http://localhost:4000
# Public URL of this site (https://yourdomain.com, no trailing slash). Canonical links, the
# sitemap, OG tags and structured data are all built from it — never leave it as localhost in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared with the backend: authenticates revalidation webhooks and the contact proxy
REVALIDATE_SECRET=dev-revalidate-secret
